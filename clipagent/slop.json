  "structures_es": [
    {
      "id": "no-solo-es",
      "regex": "(?i)\\bno es (?:solo|solamente) [^.!?\\n]{2,60}[,.] es\\b",
      "name": "«No es solo X, es Y»",
      "fix": "Di lo que quieres decir. Borra la primera mitad.",
      "source": "equiv. de not-just (slop.json structures)"
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno solo\\b[^.!?\\n]{2,80}\\bsino (?:también|tambien)\\b",
      "name": "«No solo X, sino también Y»",
      "fix": "Parte en dos frases, o borra la mitad más floja.",
      "source": "equiv. de not-only (slop.json structures)"
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!] se trata de\\b",
      "name": "«No se trata de X. Se trata de Y.»",
      "fix": "Empieza por Y. La inversión es la marca.",
      "source": "equiv. de isnt-about (slop.json structures)"
    },
    {
      "id": "stop-scroll-es",
      "regex": "(?im)^\\s*(?:deja de scrollear|no hagas scroll|espera,? no hagas scroll)\\b",
      "name": "«Deja de scrollear» al inicio",
      "fix": "El freno tiene que ser el claim mismo. Pedir atención es la marca de no haberla ganado.",
      "source": "equiv. de stop-scroll (slop.json structures)"
    },
    {
      "id": "en-este-video-es",
      "regex": "(?i)\\b(?:en (?:este|el) (?:vídeo|video)|hoy te voy a (?:enseñar|mostrar) cómo|te voy a (?:enseñar|mostrar) cómo)\\b",
      "name": "Preámbulo de vídeo («en este vídeo te voy a enseñar»)",
      "fix": "Bórralo y empieza por el payoff. Los dos primeros segundos deciden el reel.",
      "source": "equiv. de in-this-video (slop.json structures)"
    },
    {
      "id": "follow-bait-es",
      "regex": "(?i)\\b(?:sígueme para más|etiqueta a alguien|dale like si|comparte esto si|comenta abajo si)\\b",
      "name": "Cebo reflejo de seguir o etiquetar",
      "fix": "Pide la única acción que este post se gana.",
      "source": "equiv. de follow-bait (slop.json structures)"
    },
    {
      "id": "engagement-bait-es",
      "regex": "(?i)\\b(?:¿estás de acuerdo\\?|¿qué opinas\\?|¿alguien más\\?|¿me equivoco\\?)\\s*$",
      "name": "Cebo reflejo de interacción",
      "fix": "Pregunta algo que solo tú puedas preguntar, sobre lo concreto de arriba.",
      "source": "equiv. de engagement-bait (slop.json structures)"
    }
  ],
