# Copia este archivo a `.env` (gitignored, nunca se sube a GitHub)
# y pon tus valores. Sin valores: las funciones que los necesitan
# usan su ruta sin credenciales y lo dicen.
#
# Twitch (Helix, gratis): solo para el monitor de influencers
# (watcher.py) por la vía oficial. Sin ellos, el monitor usa la
# ruta pública GQL y sirve igual para vigilar.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
#
# Gemini (gratis, AI Studio): solo para la visión
# (thumbnails.py --vision: elegir el mejor frame para la miniatura).
# Sin ella, la visión queda apagada y la app funciona igual.
GEMINI_API_KEY=
#
# Ruta al TwitchDownloaderCLI, si no está en el PATH.
# (auto_clips.py también acepta config.yaml -> tools.twitch_downloader_cli)
TWITCH_DL_CLI=
