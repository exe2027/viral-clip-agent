# wrangler.kaez.toml — Worker por usuario: UN SOLO TENANT (kaez).
# Decisión del usuario 2026-11-19: cada cuenta/tenant tiene su propio
# Worker desplegado (código igual para todos, solo cambia
# configuración/APIs/cuentas por usuario). Este Worker sirve
# EXACTAMENTE al tenant "kaez" (var TENANT): sesiones, tokens del
# cerebro, OAuth, login y cron de otro tenant dan 401 / no se
# ejecutan aquí.
#
# Recursos (cuenta de Cloudflare de Sebastián):
#   D1     clips-avc-kaez       (una base SOLO con filas de kaez)
#   R2     clips-avc            (compartido; keys clips/<tenant>/<clip_id>/...)
#   Worker avc-kaez             (este archivo; avc-kaez.<cuenta>.workers.dev)
#   Cron   cada minuto (un ciclo para kaez)
#
# SIN secretos aquí: los secretos van con `wrangler secret put
# --config wrangler.kaez.toml` (los mismos 8 que el Worker `avc`:
# BRIDGE_TOKEN, CREDENTIAL_ENCRYPTION_KEY, GITHUB_TOKEN,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET,
# TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET).
# OJO CREDENTIAL_ENCRYPTION_KEY (2026-11-20): el valor maestro viejo
# NO es recuperable (nunca quedó registrado); NO se puede copiar.
# El Worker nuevo lleva una clave FRESCA y las credenciales migradas
# (credential_enc) hay que RE-CIFRARLAS desde el Worker viejo — que
# sí tiene la clave vieja en runtime — antes del cutover, o no
# descifrarán. Ver el plan de re-cifrado del coordinador.
# database_id: D1 clips-avc-kaez (creada por la migración 2026-11-19).
#
# Despliegue: python3 scripts/deploy_with_token.py deploy-worker-kaez

name = "avc-kaez"
main = "worker/src/index.ts"
compatibility_date = "2026-11-17"
workers_dev = true

# Cron del Worker: cada minuto avanza la cola de kaez SOLO si kaez
# inició su Worker (botón Iniciar en la pestaña Worker).
[triggers]
crons = ["* * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "clips-avc-kaez"
database_id = "7ce9af3c-110b-4ffe-8224-29ef0a3d78fa"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "CLIPS_BUCKET"
bucket_name = "clips-avc"

[vars]
# Tenant ÚNICO de este Worker. Si falta o no es "kaez", el Worker
# falla en voz alta (requireTenant, auth.ts): nunca un default
# silencioso.
TENANT = "kaez"
# (2026-11-18, hallazgo M2) Sin PUBLIC_BASE_URL: el bucket R2 es
# privado y no hay dominio público r2.dev. Instagram recibe una URL
# firmada del Worker (/api/public-video, 15 min) solo al publicar.
ALLOWED_EMAIL = ""
# Repo del cerebro (vía principal): el botón Iniciar dispara su
# workflow con repository_dispatch (panel-start). El token
# va como secreto GITHUB_TOKEN (wrangler secret put), nunca aquí.
GITHUB_REPO = "exe2027/viral-clip-agent"
# URL pública de R2 para que el cerebro (y las plataformas) puedan
# descargar los clips: valor PÚBLICO, no secreto (2026-11-19,
# cerebro genérico: el cerebro la recibe en /api/bridge/credentials).
CLIP_PUBLIC_BASE_URL = "https://pub-5f09f432fcae41dcb9e4d114ce8ff987.r2.dev"
