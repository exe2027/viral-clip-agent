function apiGroupOf(a) {
  const p = String(a.platform || "").toLowerCase();
  if (p === "meta" || p === "instagram" || p === "facebook") return "meta";
  if (p === "youtube") return "youtube";
  if (p === "tiktok") return "tiktok";
  return p || "meta";
}
function apiAccountCardHtml(a) {
