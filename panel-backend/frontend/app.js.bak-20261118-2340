function workerButtonsDisabled(start, stop, runOnce, refresh) {
  $("btnStart").disabled = start;
  $("btnStop").disabled = stop;
  $("btnRunOnce").disabled = runOnce;
  $("btnRefreshW").disabled = refresh;
